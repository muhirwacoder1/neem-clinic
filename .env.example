# TanStack Start / Vite configuration
VITE_CONVEX_URL=
# Use the Clerk publishable key here (NEXT_PUBLIC_ is for Next.js).
VITE_CLERK_PUBLISHABLE_KEY=
# Optional server override for the same deployment
CONVEX_URL=
# Generate separate random values and set the same values on Convex
CLINIC_SERVER_SECRET=
CRON_SECRET=
# Local development: http://localhost:5173; deployed app: canonical HTTPS URL
APP_ORIGIN=
# Direct Resend integration (app server only)
RESEND_API_KEY=
# Address on a domain verified in your Resend account; display name is NEEM Wellness
RESEND_FROM_EMAIL=

# Convex deployment settings (set through the Convex CLI/dashboard):
# CLERK_JWT_ISSUER_DOMAIN (https://<your-instance>.clerk.accounts.dev for test)
# CLINIC_SERVER_SECRET
# CRON_SECRET
# APP_ORIGIN
# BOOTSTRAP_ADMIN_EMAIL (first installation with no existing super_admin)
# CLERK_SECRET_KEY (staff invitation action)
# NEEM_EMAILS_ENABLED (leave disabled in staging)
# Never prefix server secrets with VITE_ or copy them into browser code.
